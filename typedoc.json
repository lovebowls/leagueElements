{
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "exclude": ["**/*.test.ts", "**/__tests__/**"],
  "theme": "default",
  "name": "@lovebowls/leagueElements",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "includeVersion": true,
  "hideGenerator": true,
  "categorizeByGroup": true,
  "categoryOrder": ["Elements", "Types", "*"],
  "blockTags": [
    "@element",
    "@attr",
    "@param",
    "@returns",
    "@return",
    "@deprecated",
    "@private",
    "@packageDocumentation"
  ],
  "modifierTags": [
    "@deprecated",
    "@private"
  ]
} 